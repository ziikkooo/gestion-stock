# The app works locally without Azure when STOCK_BACKEND=memory.
STOCK_BACKEND=memory
# After creating Cosmos DB for NoSQL, switch this to cosmos.
# STOCK_BACKEND=cosmos
COSMOS_ENDPOINT=https://YOUR-COSMOS-ACCOUNT.documents.azure.com:443/
COSMOS_KEY=REPLACE_WITH_YOUR_PRIVATE_KEY
COSMOS_DATABASE=stockmanager
COSMOS_CONTAINER=warehouses
STOCK_WAREHOUSE_ID=main
# Use only behind HTTPS in deployed environments.
STOCK_HTTPS_ONLY=0
